#!/usr/bin/env bash
# transcribe — send an audio/video file to the fleet WhisperX service
# (comfyui VM's 4090, proxied by caddy) and produce a transcript with speaker
# labels, optionally with LLM minutes that say who was assigned what.
#
# Usage:
#   transcribe FILE                       # labelled transcript to stdout
#   transcribe FILE -o meeting.txt        # ...written here instead
#   transcribe FILE                       # + $TRANSCRIBE_OUT_DIR set -> file there
#   transcribe FILE --summarize           # + strata minutes (summary, decisions,
#                                         #   agreed tasks with owners, open
#                                         #   questions) appended after "---"
#   transcribe FILE --labels "Gareth,Pete"  # name the voices (order of first
#                                         #   speech; default SPEAKER_01, ...)
#   transcribe FILE -f srt -o out.srt     # SRT with [SPEAKER_xx] labels
#   transcribe FILE -f json | jq .utterances
#   transcribe FILE -l de                 # force language (default: auto)
#   transcribe FILE --no-diarize          # plain transcript, no speakers
#   transcribe --health                   # service status
#
# Where the output goes — in order:
#   1. -o/--output PATH       writes there (parents created)
#   2. $TRANSCRIBE_OUT_DIR    writes <stem>-<stamp>.<ext> in that directory
#                             (created if missing; point it at something backed
#                             up, because the server deliberately keeps nothing)
#   3. neither                stdout
# The service NEVER stores anything: comfyui is a processor, not a storage, so
# the machine holding the recording decides where its transcript lives.
#
# Formats: txt (default), srt, vtt, json.  Minutes ride along as markdown for
# txt and as the `summary_markdown' field for json; subtitles cannot hold prose,
# so -f srt/vtt --summarize returns cues only and says so on stderr.
# Endpoint override: TRANSCRIBER_URL (default https://transcribe.ts.peteches.co.uk).
#
# Speaker labels come from NVIDIA SortFormer v2.1 running on the service's CPU —
# not pyannote — so diarization needs no HuggingFace account, token or accepted
# terms.  The model itself is ungated and is downloaded once into the server's
# cache on the first diarized request (~470 MB).
#
# Timings: the first request after an idle period loads whisper large-v3 + the
# alignment model onto the GPU (~15-30s before real work starts), and minutes add
# a further LLM round-trip.  A 47-minute meeting costs roughly 40s of GPU plus
# ~1 minute of CPU diarization; do not Ctrl-C early — the server keeps working.

set -euo pipefail

URL="${TRANSCRIBER_URL:-https://transcribe.ts.peteches.co.uk}"

# TLS trust.  Guix has no /etc/ssl/certs, and curl only finds a bundle when
# something exports SSL_CERT_FILE/SSL_CERT_DIR (nss-certs in the profile) --
# which is not installed here, so a plain upload fails with curl's exit 60
# ("server could not be verified") instead of a transcript.  When nothing is
# configured, fall back to the openssl bundle that IS part of every Guix
# System profile.
ca=()
if [[ -z "${SSL_CERT_FILE:-}" && -z "${CURL_CA_BUNDLE:-}" ]]; then
  for cand in /run/current-system/profile/etc/ssl/certs/ca-certificates.crt \
              /etc/ssl/certs/ca-certificates.crt; do
    [[ -r "$cand" ]] && { ca=(--cacert "$cand"); break; }
  done
fi

die() { echo "transcribe: $*" >&2; exit 1; }

fmt=txt lang="" diarize=true summarize=false labels="" file="" out=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -f|--format)   fmt="${2:?missing format}"; shift 2 ;;
    -l|--language) lang="${2:?missing language}"; shift 2 ;;
    -o|--output)   out="${2:?missing output path}"; shift 2 ;;
    --labels|--speaker-labels) labels="${2:?missing speaker names}"; shift 2 ;;
    --summarize|-s) summarize=true; shift ;;
    --no-diarize)  diarize=false; shift ;;
    --health)      curl -fsS "${ca[@]}" "$URL/health"; echo; exit 0 ;;
    -h|--help)     awk 'NR>1 && /^set -euo/{exit} NR>1{sub(/^# ?/,""); print}' "$0"
                   exit 0 ;;
    -*)            die "unknown option: $1 (try --help)" ;;
    *)             [[ -z "$file" ]] || die "only one input file supported"; file="$1"; shift ;;
  esac
done

[[ -n "$file" ]] || die "no input file (try --help)"
[[ -f "$file" ]] || die "not a file: $file"
case "$fmt" in txt|srt|vtt|json) ;; *) die "format must be txt|srt|vtt|json" ;; esac
# Minutes are an allocation of tasks to people, so they need the labels.
if [[ "$summarize" == true && "$diarize" != true ]]; then
  die "--summarize needs diarization (owners come from the speaker labels); drop --no-diarize"
fi

args=(-F "file=@${file}" -F "format=${fmt}" -F "diarize=${diarize}")
[[ -n "$lang" ]] && args+=(-F "language=${lang}")
[[ "$summarize" == true ]] && args+=(-F "summarize=true")
[[ -n "$labels" ]] && args+=(-F "speaker_labels=${labels}")

hdr=$(mktemp)
body=$(mktemp)
trap 'rm -f "$hdr" "$body"' EXIT

# Response body and status are fetched separately: a failure's plain-text reason
# must reach stderr, not the transcript pipeline.
code=$(curl -sS --max-time 7200 -D "$hdr" -o "$body" -w '%{http_code}' \
           "${ca[@]}" "${args[@]}" "$URL/transcribe") || die "upload failed (network?)"

if [[ "$code" != 200 ]]; then
  cat "$body" >&2
  die "server returned HTTP $code"
fi

# The server drops minutes for subtitle formats rather than corrupting them; it
# says so in a header, and saying so here is the difference between an operator
# wondering where the summary went and knowing.
awk 'tolower($0) ~ /^x-summary-note:/ { sub(/^[^:]*:[ \t]*/, ""); print }' "$hdr" >&2

if [[ -z "$out" && -n "${TRANSCRIBE_OUT_DIR:-}" ]]; then
  # No explicit path but a declared drop-off directory: name the file after the
  # recording and its time, so a recurring meeting accumulates chronologically.
  stem=$(basename -- "$file"); stem="${stem%.*}"
  stem=$(printf '%s' "$stem" | tr -c 'A-Za-z0-9._-' '-' \
           | sed -E 's/-+/-/g; s/^-+//; s/-+$//')
  [[ -n "$stem" ]] || stem=meeting
  mkdir -p -- "$TRANSCRIBE_OUT_DIR"
  out="$TRANSCRIBE_OUT_DIR/${stem}-$(date +%Y%m%d-%H%M%S).${fmt}"
fi

if [[ -n "$out" ]]; then
  mkdir -p -- "$(dirname -- "$out")"
  cat "$body" > "$out"
  echo "transcribe: wrote $out ($(wc -c < "$out") bytes)" >&2
else
  cat "$body"
fi
